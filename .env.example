# Copy to .env.local (never commit real values). All variables are server-side only.
# Required for LIVE NEMOTRON mode; without it the app runs in OFFLINE DEMO mode.
NEBIUS_API_KEY=
# Optional overrides (defaults shown)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_MODEL_PROPOSE=        # e.g. a smaller Nemotron for routine proposals
# NEBIUS_MODEL_INTERPRET=      # e.g. a larger Nemotron for interpretation
NEBIUS_TIMEOUT_MS=30000
NEBIUS_MAX_RETRIES=2
NEBIUS_MAX_TOKENS=2048
NEBIUS_TEMPERATURE=0.2
# NEBIUS_JSON_MODE=off         # disable response_format if a model rejects it
# Prices (USD per 1M tokens) only if you want cost estimates; nothing is assumed.
# NEBIUS_PRICE_INPUT_PER_M=
# NEBIUS_PRICE_OUTPUT_PER_M=
# Best-effort per-instance abuse limits for the public demo
PILOT_LIVE_CALLS_PER_CLIENT_10MIN=12
PILOT_LIVE_CALLS_PER_HOUR=120
# Optional: >=32 random chars; lets this deployment attest its own live records
# EVIDENCE_ATTESTATION_SECRET=
