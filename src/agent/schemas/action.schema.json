{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crystaltwin.ai/schemas/agent-action.schema.json",
  "title": "CrystalTwin agent proposal",
  "type": "object",
  "required": ["proposed_action", "reason", "evidence", "confidence"],
  "properties": {
    "proposed_action": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "enum": [
            "hold",
            "temperature_offset_delta_norm",
            "seed_rpm_delta_norm",
            "crucible_rpm_delta_norm",
            "rf_power_delta_norm",
            "magnetic_field_delta_norm"
          ]
        },
        "value": { "type": "number" }
      },
      "additionalProperties": false
    },
    "reason": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
